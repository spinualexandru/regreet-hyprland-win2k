+/// Drop the selection when a text field loses the keyboard focus, like a Win32 edit control.
+///
+/// GTK selects the whole text when a field is tabbed into, and would otherwise keep showing that
+/// selection after the focus has moved on.
+fn clear_selection_on_blur(entry: &gtk::Entry) {
+    let focus = gtk::EventControllerFocus::new();
+    focus.connect_leave({
+        let entry = entry.clone();
+        move |_| {
+            let position = entry.position();
+            entry.select_region(position, position);
+        }
+    });
+    entry.add_controller(focus);
+}
